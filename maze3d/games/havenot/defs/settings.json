 "panels": {
  "exit": {
   "prop": "terminal_wall",
   "blocks": false,
   "screen": "EXIT",
   "use": {
    "type": "effects",
    "prompt": "Leave #name#",
    "effects": [
     {
      "type": "end",
      "title": "Out of #name#",
      "text": "It was built to #mandate#. It #now#."
     }
    ]
   }
  },
  "memo": {
   "prop": [
    "terminal_desk",
    "typewriter_desk"
   ],
   "blocks": false,
   "use": {
    "type": "read",
    "prompt": "Read the memo",
    "kicker": "#name#",
    "title": "#memo_title#",
    "text": "#memo#"
   }
  },
  "generator": {
   "prop": "terminal_desk",
   "blocks": false,
   "screen": "POWER",
   "tag": "gen_panel",
   "use": {
    "type": "terminal",
    "prompt": "Use the generator panel",
    "kicker": "#name#",
    "title": "MAIN POWER",
    "text": "Main power: {sys:power}\nVentilation: {sys:air}",
    "options": [
     {
      "label": "Shut the generator down",
      "effects": [
       {
        "type": "system",
        "system": "power",
        "to": "off"
       }
      ],
      "result": "It winds down to nothing. The emergency lights come on.",
      "needs": {
       "power": "on"
      },
      "missing": "It is not running."
     },
     {
      "label": "Start the generator",
      "effects": [
       {
        "type": "system",
        "system": "power",
        "to": "on"
       },
       {
        "type": "flag",
        "name": "power_on"
       }
      ],
      "result": "The generator coughs, catches, and runs. Somewhere a door unlocks with relief.",
      "needs": {
       "power": "off"
      },
      "missing": "It is already running."
     },
     {
      "label": "Switch the ventilation",
      "effects": [
       {
        "type": "system",
        "system": "air",
        "next": true
       }
      ],
      "result": "The fans change their note."
     }
    ]
   }
  },
  "security": {
   "prop": "terminal_desk",
   "blocks": false,
   "screen": "SECURITY",
   "tag": "sec_panel",
   "needs": {
    "power": "on"
   },
   "use": {
    "type": "terminal",
    "prompt": "Use the security panel",
    "kicker": "#name#",
    "title": "SECURITY",
    "text": "Security: {sys:security}",
    "options": [
     {
      "label": "Shut security down",
      "effects": [
       {
        "type": "system",
        "system": "security",
        "to": "off"
       },
       {
        "type": "flag",
        "name": "security_off"
       }
      ],
      "result": "The cameras droop."
     },
     {
      "label": "Stand down",
      "effects": [
       {
        "type": "system",
        "system": "security",
        "to": "normal"
       }
      ]
     },
     {
      "label": "Raise the alert",
      "effects": [
       {
        "type": "system",
        "system": "security",
        "to": "alert"
       }
      ],
      "result": "You did that on purpose."
     }
    ]
   }
  },
  "core": {
   "prop": "terminal_desk",
   "blocks": false,
   "screen": "CORE",
   "tag": "core_terminal",
   "use": {
    "type": "terminal",
    "prompt": "Use the #core#",
    "kicker": "#name#",
    "title": "#core#",
    "text": "#directive#\n\nMain power: {sys:power} · Security: {sys:security}",
    "options": [
     {
      "label": "Read the mandate",
      "result": "Built to #mandate#.\nNow it #now#."
     },
     {
      "label": "Log what it is doing",
      "once": true,
      "effects": [
       {
        "type": "flag",
        "name": "core_reached"
       }
      ],
      "result": "Logged. Nobody will read it, but now somebody could."
     }
    ]
   }
  },
  "release": {
   "prop": "terminal_wall",
   "blocks": false,
   "screen": "OPEN",
   "tag": "gate_release",
   "use": {
    "type": "effects",
    "prompt": "Unlock #gate# from this side",
    "effects": [
     {
      "type": "flag",
      "name": "#gate_flag#"
     },
     {
      "type": "message",
      "text": "#gate# unlocks with a thud. The short way back is open.",
      "kind": "info"
     }
    ]
   }
  }
 },
