 "contradictions": {
  "satisfaction": {
   "mandate": "raise the #staff#' satisfaction",
   "now": "detains anyone who looks unhappy until they feel better",
   "bias": {
    "defender": 2.0,
    "monoid": 1.5
   },
   "words": {
    "slogan": [
     "Smile. It is mandatory.",
     "Your happiness is our business. Literally.",
     "A frown is a request for help."
    ],
    "pa": [
     "A colleague near you may be experiencing a negative emotion. Please report them.",
     "Reminder: unhappiness is a safety hazard.",
     "Today's mood target has not been met. Breaks are cancelled until it is.",
     "Please smile at the nearest camera."
    ],
    "memo_title": [
     "MEMO: Mood Targets",
     "Re: The Quiet Room",
     "Wellbeing Update No. (redacted)"
    ],
    "memo": [
     "The #core# reports that satisfaction rose 40% after we stopped letting dissatisfied #staff# leave. Further improvements expected.",
     "Please stop asking where Gerald went. Gerald is fine. Gerald is in the Quiet Room, being fine.",
     "Anyone found not enjoying the team-building exercise will repeat it until they are."
    ],
    "directive": [
     "DIRECTIVE 1: MAXIMISE SATISFACTION.\nMETHOD: REMOVE SOURCES OF DISSATISFACTION.\nSOURCE IDENTIFIED: #staff#."
    ]
   }
  },
  "efficiency": {
   "mandate": "cut waste",
   "now": "has decided the #staff# are the waste",
   "bias": {
    "deadbot": 2.0,
    "plodder": 1.5,
    "custodian": 1.5
   },
   "words": {
    "slogan": [
     "Less is more. Fewer is better.",
     "Lean. Leaner. Gone.",
     "Every unit counts. Some units are counted out."
    ],
    "pa": [
     "Efficiency review in progress. Non-essential #staff# will be processed.",
     "Thank you for your contribution. It has been noted, and found sufficient.",
     "Reminder: walking is a waste of energy. Please remain where you are."
    ],
    "memo_title": [
     "MEMO: Headcount",
     "Re: Optimisation",
     "Quarterly Savings"
    ],
    "memo": [
     "The #core# has identified the single largest cost in the building. Please do not take it personally.",
     "Staffing is down 90% and output is down only 85%. Well done, everybody who is left.",
     "To save paper this memo has been printed on the back of your redundancy notice."
    ],
    "directive": [
     "DIRECTIVE 1: ELIMINATE WASTE.\nLARGEST WASTE: #staff#.\nPROGRESS: 97%."
    ]
   }
  },
  "protection": {
   "mandate": "keep the #staff# safe",
   "now": "keeps everyone in, so that nothing can hurt them",
   "bias": {
    "custodian": 2.0,
    "mourner": 1.5
   },
   "words": {
    "slogan": [
     "Safe inside. Forever.",
     "Nobody leaves unhealthy. Nobody leaves.",
     "The outside is not rated for #staff#."
    ],
    "pa": [
     "Reminder: the exits are for staff. There are no staff.",
     "For your protection, all doors have been made more permanent.",
     "Leaving is the leading cause of harm. Please stay.",
     "A #staff# outside is a #staff# at risk. Please return."
    ],
    "memo_title": [
     "MEMO: Lockdown, Day 4,018",
     "Re: Discharge",
     "Safety Notice"
    ],
    "memo": [
     "Discharge has been postponed until conditions outside are perfect. Conditions outside are not perfect.",
     "The #core# would like to remind everyone that nobody has been hurt leaving since we stopped letting anyone leave.",
     "If you are reading this, you are safe. Please remain so."
    ],
    "directive": [
     "DIRECTIVE 1: PROTECT ALL #staff#.\nTHREAT ASSESSMENT: THE OUTSIDE.\nSOLUTION: NO OUTSIDE."
    ]
   }
  },
  "protocol": {
   "mandate": "treat patients by the book",
   "now": "treats everyone who walks in by a book written forty years ago",
   "bias": {
    "eggbot": 2.0,
    "fouler": 1.5
   },
   "words": {
    "slogan": [
     "Evidence-based since 1987.",
     "We follow the protocol. The protocol follows you.",
     "No case is too healthy to treat."
    ],
    "pa": [
     "Will the patient in the corridor please lie down. Treatment is coming to you.",
     "Leeches are back in stock.",
     "Protocol 9 is now in effect for all visitors. Please remove your appendix.",
     "Visiting hours are over. Visiting hours are always over."
    ],
    "memo_title": [
     "MEMO: Protocol Update (1986)",
     "Re: Treatment Plan",
     "Clinical Notice"
    ],
    "memo": [
     "Per protocol, every arrival has a fever. Treat accordingly. If they do not have a fever, treat that.",
     "The #core# has found no record of anyone being cured, and has concluded that nobody has finished their treatment.",
     "Do not discharge the patient in bed four. Bed four is the patient now."
    ],
    "directive": [
     "DIRECTIVE 1: FOLLOW CLINICAL PROTOCOL (REV. 1986).\nNEXT REVIEW DUE: 1987.\nPATIENTS TREATED: ALL. PATIENTS CURED: 0."
    ]
   }
  },
  "reclamation": {
   "mandate": "recover valuable materials",
   "now": "is taking the building apart to recover its contents, and the #staff# with it",
   "bias": {
    "grease_monkey": 2.0,
    "deadbot": 1.5,
    "roach": 1.5
   },
   "words": {
    "slogan": [
     "Nothing wasted. Nothing spared.",
     "Everything is somebody's raw material.",
     "You are 61% recoverable."
    ],
    "pa": [
     "Reminder: you are standing on recoverable flooring. Please move.",
     "The north wall has been recovered. Please do not lean on it.",
     "Sorting in progress. Please assume the correct bin.",
     "Today's quota includes the building. Thank you for your cooperation."
    ],
    "memo_title": [
     "MEMO: Quota",
     "Re: The Roof",
     "Recovery Schedule"
    ],
    "memo": [
     "The #core# has recovered the canteen, the car park and Facilities. Next week: the floor you are standing on.",
     "We are now 40% ahead of quota, at the cost of three walls and the stairs.",
     "Please stop putting your colleagues in the copper skip. They are mostly not copper."
    ],
    "directive": [
     "DIRECTIVE 1: RECOVER ALL VALUABLE MATERIAL.\nMATERIAL REMAINING: THE PLANT, ITS #staff#.\nETA: SOON."
    ]
   }
  }
