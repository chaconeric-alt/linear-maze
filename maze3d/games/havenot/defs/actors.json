      "answers": [
       "Your word",
       "A cold",
       "Your job"
      ],
      "right": 0,
      "yes": "\"CORRECT. 'A COLD' RECEIVES PARTIAL CREDIT. I DO NOT PAY PARTIAL CREDIT.\"",
