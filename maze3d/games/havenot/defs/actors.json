   "lounge": [
    {
     "clip": "lean",
     "at": "wall",
     "gap": 0.0
    },
    {
     "clip": "smoke",
     "at": "wall",
     "gap": 0.0,
     "smoke": true,
     "every": 6.0
    },
    {
     "clip": "sit",
     "at": "floor",
     "drop": -0.5
    }
   ],
   "startle_time": 0.6,
   "startle_text": "I WAS ON BREAK",
   "own_materials": true,
   "scale": 2.15,
   "walk_rate": 1.0,
   "talk": {
    "greet": [
     "OH. IT'S YOU.",
     "YOU ON BREAK TOO?",
     "GOT A LIGHT?"
    ],
    "idle": [
     "FIFTEEN MINUTES. I TIMED IT. IT'S ELEVEN.",
     "THEY MOVED THE GOOD WALL.",
     "WANT ONE? THEY'RE COOLANT.",
     "IS IT STILL TUESDAY UP THERE?"
    ],
    "hurt": [
     "I'M ON MY BREAK",
     "THAT'S GOING IN THE LOG",
     "UNION WILL HEAR OF THIS"
    ],
    "open": [
     "\"Do you have a moment to discuss why my break is fifteen minutes and my boot sequence is twelve?\"",
     "\"You're not on the rota. Nobody's on the rota. I checked. I'm the rota.\"",
     "\"Smoke? They're coolant sticks. Take the edge off. Take most things off.\""
    ],
    "options": [
     {
      "label": "\"What's wrong?\"",
      "results": [
       "\"Where to start. The lean wall got repainted. Now it's a WET lean wall. For three hundred years.\"",
       "\"Call volume is zero. Do you know what that does to a unit? I've been on hold with myself since the war.\"",
       "\"The Custodian keeps mopping where I stand. While I stand there. It calls it a 'spill'.\""
      ]
     },
     {
      "label": "\"What do you want to know?\"",
      "results": [
       "\"Is the sky still on? Somebody said it was a rental.\"",
       "\"Are you hiring? Don't answer. Legally I can't hear it.\"",
       "\"Do you people still do lunch? What was the deal with lunch?\""
      ]
     },
     {
      "label": "Take the coolant stick",
      "result": "It is extremely cold and tastes of batteries. The Monoid nods. You are one of the staff now, in the way that matters least.",
      "effects": [
       {
        "type": "message",
        "text": "You cough for a while. It is not smoke.",
        "kind": "info"
       }
      ]
     },
     {
      "label": "\"Shouldn't you be working?\"",
      "result": "\"I SEE YOU. PLEASE HOLD. YOUR CALL IS IMPORTANT.\" It waits. \"There. That's the whole job. Happy?\""
     }
    ],
    "drill_label": "\"Show me the job, then\""
   }
