      "answers": [
       "Tomorrow",
       "The lift",
       "My performance review"
      ],
      "right": 0,
      "yes": "\"CORRECT. THE LIFT ARRIVES. EVENTUALLY. I HAVE WATCHED IT.\"",
      "no": "\"INCORRECT. BUT I UNDERSTAND WHY YOU SAID IT.\""
     },
