; maze3d - the Linear Maze 3D engine. Open this folder in Godot 4.4 or newer.
config_version=5

[application]

config/name="HaveNot 3D"
config/description="First-person HaveNot on the maze3d engine."
run/main_scene="res://engine/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[autoload]

LM="*res://engine/lm.gd"
Game="*res://engine/game.gd"

[maze3d]

game="havenot"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="actors"
3d_physics/layer_4="pickups"

[physics]

3d/default_gravity=22.0
common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.01, 0.012, 0.015, 1)
lights_and_shadows/positional_shadow/atlas_size=4096
